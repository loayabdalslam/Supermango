# Bee2Bee configuration
# Copy to .env and adjust as needed.

# P2P WebSocket node
BEE2BEE_HOST=0.0.0.0
BEE2BEE_PORT=4003
BEE2BEE_BOOTSTRAP=ws://127.0.0.1:4003
BEE2BEE_REGION=Auto

# Local HTTP API used by the web app
BEE2BEE_API_PORT=4002
BEE2BEE_WEB_URL=http://localhost:3000

# Optional API key for the FastAPI endpoints (/peers, /providers, /generate)
# BEE2BEE_API_KEY=change-me

# Local registry file control
BEE2BEE_LOCAL_REGISTRY=1
BEE2BEE_REGISTRY_TTL=120

# Public networking (on by default). Set to 0 to stay LAN-only.
BEE2BEE_NAT=1
# Force a specific advertised IP instead of auto-detecting it
# BEE2BEE_PUBLIC_IP=203.0.113.10
# Optional node coordinates when the heartbeat server does not return them
# BEE2BEE_LATITUDE=30.0444
# BEE2BEE_LONGITUDE=31.2357

# Heartbeat server. Defaults to the local web app: the node tries
# http://localhost:3000 then http://localhost:3001 and sticks with the first
# that answers. The node POSTs its full state and reads coordinates back.
# Leave commented to keep the automatic fallback.
# BEE2BEE_HEARTBEAT_URL=http://localhost:3000/api/heartbeat
# BEE2BEE_HEARTBEAT_TOKEN=change-me
BEE2BEE_HEARTBEAT_INTERVAL=30
BEE2BEE_HEARTBEAT_TTL=120

# Express gateway (app/)
API_PORT=3001
API_HOST=0.0.0.0
# BEE2BEE_SEEDS=ws://127.0.0.1:4003

# Logging: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Ollama backend. On some GPUs Ollama crashes with a CUDA error; set this to 0
# to force CPU inference for every request (slower, but reliable).
# BEE2BEE_OLLAMA_NUM_GPU=0

# Express gateway direct-to-node timeout in ms (default 20000)
# BEE2BEE_DIRECT_TIMEOUT_MS=20000
